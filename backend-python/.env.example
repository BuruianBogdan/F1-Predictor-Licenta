FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
# DATABASE_URL=sqlite:////absolute/path/to/database/f1.db
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
HTTP_TIMEOUT_SECONDS=25
# FASTF1_CACHE_DIR=/absolute/path/to/cache/fastf1
PREDICTION_MODE=ml
CHAMPIONSHIP_SIMULATIONS=5000
RANDOM_SEED=42
MARKET_ENABLED=true
MARKET_WEIGHT=0.15
SELENIUM_ENABLED=false
SELENIUM_HEADLESS=true
SELENIUM_TIMEOUT_SECONDS=15
ODDS_REFRESH_MINUTES=10
ODDS_SOURCES=[]
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional protection for explicit training/sync endpoints on non-local deployments
ADMIN_TOKEN=
LLM_TIMEOUT_SECONDS=20
LLM_CACHE_ENABLED=true

# Public Formula 1 news (separate from optional OpenAI explanations / odds Selenium)
NEWS_AUTO_ENABLED=true
NEWS_LLM_URL=http://127.0.0.1:11434
NEWS_LLM_MODEL=qwen3:4b-instruct
NEWS_LANGUAGE=en

# Race Control uses public unauthenticated timing and free historical replay.
